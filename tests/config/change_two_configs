#!/usr/bin/env bash

# test

tmsu config autoCreateTags=no fileFingerprintAlgorithm=none    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu config autoCreateTags fileFingerprintAlgorithm            >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - </dev/null
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
autoCreateTags=no
fileFingerprintAlgorithm=none
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
