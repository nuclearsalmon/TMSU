#!/usr/bin/env bash

# Use a path without shell metacharacters: fixture scripts expand TEST_DIR in
# both command arguments and expected output. Never reuse a pre-existing path.
export TEST_DIR=$(mktemp -d /tmp/tmsu-test.XXXXXXXX) || return 1
export HOME="$TEST_DIR/home"
export XDG_CONFIG_HOME="$HOME/.config"
mkdir -p "$HOME" || return 1
unset TMSU_DB

tmsu init "$TEST_DIR" >/dev/null 2>&1 || return 1
export TMSU_DB="$TEST_DIR/.tmsu/db"
