#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 aubergine                       >/dev/null 2>&1
mv ${TEST_DIR}/file1 ${TEST_DIR}/file1b                      >/dev/null 2>&1

# test

tmsu repair --manual ${TEST_DIR}/file1 ${TEST_DIR}/file1b    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

tmsu tags ${TEST_DIR}/file1 ${TEST_DIR}/file1b               >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: ${TEST_DIR}/file1: no such file
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1b: aubergine
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
