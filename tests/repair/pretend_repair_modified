#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 aubergine     >/dev/null 2>&1
echo horseradish >>${TEST_DIR}/file1

# test

tmsu repair --pretend ${TEST_DIR}        >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

tmsu status ${TEST_DIR}/file1            >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1: updated fingerprint
M ${TEST_DIR}/file1
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
