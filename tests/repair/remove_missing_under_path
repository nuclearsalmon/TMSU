#!/usr/bin/env bash

# setup

mkdir ${TEST_DIR}/dir1
touch ${TEST_DIR}/{file4,dir1/file1}
tmsu tag --tags="aubergine" ${TEST_DIR}/file4 ${TEST_DIR}/dir1/file1    >/dev/null 2>&1
rm ${TEST_DIR}/file4 ${TEST_DIR}/dir1/file1                             >/dev/null 2>&1

# test

tmsu repair --remove --path=${TEST_DIR}/dir1                          >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

tmsu tags ${TEST_DIR}/file4 ${TEST_DIR}/dir1/file1                      >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: ${TEST_DIR}/dir1/file1: no such file
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/dir1/file1: removed
${TEST_DIR}/file4: aubergine
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
