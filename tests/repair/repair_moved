#!/usr/bin/env bash

# setup

echo 1 >${TEST_DIR}/file4
tmsu tag ${TEST_DIR}/file4 aubergine            >/dev/null 2>&1
mv ${TEST_DIR}/file4 ${TEST_DIR}/file4b           >/dev/null 2>&1

# test

tmsu repair ${TEST_DIR}                         >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

tmsu tags ${TEST_DIR}/file4 ${TEST_DIR}/file4b    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: ${TEST_DIR}/file4: no such file
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file4: updated path to ${TEST_DIR}/file4b
${TEST_DIR}/file4b: aubergine
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
