#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 aubergine     >/dev/null 2>&1

# test

tmsu repair --unmodified ${TEST_DIR}     >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1: recalculated fingerprint
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
