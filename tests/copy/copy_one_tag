#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 aubergine    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu copy aubergine eggplant          >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

tmsu files aubergine                  >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files eggplant                   >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1
${TEST_DIR}/file1
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
