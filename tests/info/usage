#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 aubergine=good    >/dev/null 2>&1

# test

tmsu info --usage                          >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff -I "^Size" ${TEST_DIR}/stdout - <<EOF
Database: ${TEST_DIR}/.tmsu/db
Root path: ${TEST_DIR}

  aubergine 1
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
