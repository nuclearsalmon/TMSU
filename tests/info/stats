#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 aubergine=good    >/dev/null 2>&1

# test

tmsu info --stats                          >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff -I "^Size" ${TEST_DIR}/stdout - <<EOF
Database: ${TEST_DIR}/.tmsu/db
Root path: ${TEST_DIR}

Tags: 1
Values: 1
Files: 1
Taggings: 1
Mean tags per file: 1.00
Mean files per tag: 1.00
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
