#!/usr/bin/env bash

# test

tmsu imply aubergine food=vegetable         >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu imply food=vegetable song=plantlife    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

tmsu imply                             >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
tmsu: new tag 'food'
tmsu: new value 'vegetable'
tmsu: new tag 'song'
tmsu: new value 'plantlife'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
     aubergine -> food=vegetable
food=vegetable -> song=plantlife
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
