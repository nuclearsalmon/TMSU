#!/usr/bin/env bash

# test

tmsu imply name=courgette name=zucchini    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu imply name=courgette name=marrow      >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

tmsu imply                                 >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'name'
tmsu: new value 'courgette'
tmsu: new value 'zucchini'
tmsu: new value 'marrow'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
name=courgette -> name=marrow
name=courgette -> name=zucchini
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
