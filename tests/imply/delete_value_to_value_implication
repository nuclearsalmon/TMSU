#!/usr/bin/env bash

# setup

tmsu imply food=aubergine class=vegetable             >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu imply                                            >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# test

tmsu imply --delete food=aubergine class=vegetable    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

tmsu imply                                      >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'food'
tmsu: new value 'aubergine'
tmsu: new tag 'class'
tmsu: new value 'vegetable'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
food=aubergine -> class=vegetable
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
