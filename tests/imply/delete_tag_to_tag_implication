#!/usr/bin/env bash

# setup

tmsu imply aubergine vegetable             >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu imply                                 >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# test

tmsu imply --delete aubergine vegetable    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

tmsu imply                                 >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
tmsu: new tag 'vegetable'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
aubergine -> vegetable
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
