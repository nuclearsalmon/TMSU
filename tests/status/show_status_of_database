#!/usr/bin/env bash

# setup

mkdir -p ${TEST_DIR}/dir
echo 1 >${TEST_DIR}/file1
echo 2 >${TEST_DIR}/file2
echo 3 >${TEST_DIR}/file3
echo 4 >${TEST_DIR}/dir/file4
touch ${TEST_DIR}/file1 ${TEST_DIR}/file2 ${TEST_DIR}/file3 ${TEST_DIR}/dir/file4
tmsu tag ${TEST_DIR}/file1 aubergine    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tag ${TEST_DIR}/file2 aubergine    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tag ${TEST_DIR}/file3 aubergine    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tag ${TEST_DIR}/dir aubergine     >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
rm ${TEST_DIR}/file2
echo changed >>${TEST_DIR}/file3

# test

tmsu status                           >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
T ${TEST_DIR}/dir
T ${TEST_DIR}/file1
M ${TEST_DIR}/file3
! ${TEST_DIR}/file2
U ${TEST_DIR}/dir/file4
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
