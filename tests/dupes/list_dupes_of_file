#!/usr/bin/env bash

# setup

echo dupe >${TEST_DIR}/file1
cp ${TEST_DIR}/file1 ${TEST_DIR}/file2
tmsu tag --tags="aubergine" ${TEST_DIR}/file1    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu dupes ${TEST_DIR}/file2                     >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
