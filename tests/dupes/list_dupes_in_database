#!/usr/bin/env bash

# setup

echo dupe >${TEST_DIR}/file1
cp ${TEST_DIR}/file1 ${TEST_DIR}/file2
mkdir -p ${TEST_DIR}/dir
cp ${TEST_DIR}/file1 ${TEST_DIR}/dir/file3
tmsu tag --tags="aubergine" ${TEST_DIR}/file1 ${TEST_DIR}/file2    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tag --recursive ${TEST_DIR}/dir/file3 aubergine             >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# test

tmsu dupes                                                     >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
tmsu: '${TEST_DIR}/file2' is a duplicate
tmsu: '${TEST_DIR}/dir/file3' is a duplicate
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
Set of 3 duplicates:
  ${TEST_DIR}/file1
  ${TEST_DIR}/file2
  ${TEST_DIR}/dir/file3
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
