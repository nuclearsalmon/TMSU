#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1

tmsu tag ${TEST_DIR}/file1 aubergine potato   >/dev/null 2>&1

# test

tmsu merge aubergine brocolli potato        >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

tmsu tags                                   >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: no such tag 'brocolli'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
potato
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
