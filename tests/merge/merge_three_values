#!/usr/bin/env bash

# setup

mkdir ${TEST_DIR}/dir1
touch ${TEST_DIR}/{file1,file2,dir1/file1}

tmsu tag ${TEST_DIR}/file1 vegetable=aubergine        >/dev/null 2>&1
tmsu tag ${TEST_DIR}/file2 vegetable=potato           >/dev/null 2>&1
tmsu tag ${TEST_DIR}/dir1/file1 vegetable=brocolli    >/dev/null 2>&1

# test

tmsu merge --value aubergine potato brocolli        >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

tmsu values                                         >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files vegetable=brocolli                       >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
brocolli
${TEST_DIR}/file1
${TEST_DIR}/file2
${TEST_DIR}/dir1/file1
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
