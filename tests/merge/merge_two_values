#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/{file1,file2}
tmsu tag ${TEST_DIR}/file1 vegetable=aubergine    >/dev/null 2>&1
tmsu tag ${TEST_DIR}/file2 vegetable=potato       >/dev/null 2>&1

# test

tmsu merge --value aubergine potato             >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

tmsu values                                     >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files vegetable=potato                     >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
potato
${TEST_DIR}/file1
${TEST_DIR}/file2
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
