#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 vegetable=aubergine    >/dev/null 2>&1

# test

tmsu merge --value aubergine aubergine          >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

tmsu values                                     >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: cannot merge value 'aubergine' into itself
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
aubergine
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
