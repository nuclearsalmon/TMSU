#!/usr/bin/env bash

# setup

tmsu tag --tags="crocodile" --force "${TEST_DIR}"'/file:' "${TEST_DIR}"'/file\' "${TEST_DIR}"'/file\:'    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu tags "${TEST_DIR}"'/file:' "${TEST_DIR}"'/file\' "${TEST_DIR}"'/file\:'                              >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'crocodile'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file\\:: crocodile
${TEST_DIR}/file\\\\: crocodile
${TEST_DIR}/file\\\\\\:: crocodile
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
