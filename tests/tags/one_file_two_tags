#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 aubergine potato    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu tags ${TEST_DIR}/file1                    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
tmsu: new tag 'potato'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1: aubergine potato
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
