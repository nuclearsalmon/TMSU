#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1 ${TEST_DIR}/file2
tmsu tag ${TEST_DIR}/file1 color=orange    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tag ${TEST_DIR}/file2 fruit=orange    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# test

tmsu tags --value orange                 >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'color'
tmsu: new value 'orange'
tmsu: new tag 'fruit'
tmsu: '${TEST_DIR}/file2' is a duplicate
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
orange: color fruit
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
