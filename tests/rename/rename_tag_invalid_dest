#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 aubergine    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu rename aubergine eggplant       >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
tmsu: could not rename tag 'aubergine' to 'eggplant': tag names cannot contain U+0002
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - </dev/null
if [[ $? -ne 0 ]]; then
    exit 1
fi
