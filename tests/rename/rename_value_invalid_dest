#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 year=2015    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu rename --value 2015 2016        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'year'
tmsu: new value '2015'
tmsu: could not rename value '2015' to '2016': tag value cannot contain U+0002
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - </dev/null
if [[ $? -ne 0 ]]; then
    exit 1
fi
