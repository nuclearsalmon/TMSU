#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 year=2015    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu rename --value 2015 2016         >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

tmsu files year=2016                  >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'year'
tmsu: new value '2015'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
