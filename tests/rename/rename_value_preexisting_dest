#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 year=2015 year=2016   >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu rename --value 2015 2016                  >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'year'
tmsu: new value '2015'
tmsu: new value '2016'
tmsu: value '2016' already exists
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - </dev/null
if [[ $? -ne 0 ]]; then
    exit 1
fi
