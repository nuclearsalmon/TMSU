#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 aubergine eggplant    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu rename aubergine eggplant                 >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
tmsu: new tag 'eggplant'
tmsu: tag 'eggplant' already exists
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - </dev/null
if [[ $? -ne 0 ]]; then
    exit 1
fi
