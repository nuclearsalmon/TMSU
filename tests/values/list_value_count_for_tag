#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 vegetable=brocolli year=2015 year=2016    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu values --count year                                           >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'vegetable'
tmsu: new value 'brocolli'
tmsu: new tag 'year'
tmsu: new value '2015'
tmsu: new value '2016'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
2
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
