#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 year=2015      >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu untag ${TEST_DIR}/file1 year=2015    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

tmsu values                             >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'year'
tmsu: new value '2015'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
2015
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
