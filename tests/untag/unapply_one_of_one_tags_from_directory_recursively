#!/usr/bin/env bash

#TODO pipe to `sort` below should be unnecessary

# test

mkdir -p ${TEST_DIR}/dir
echo 1 >${TEST_DIR}/dir/file1
echo 2 >${TEST_DIR}/dir/file2
tmsu tag --recursive ${TEST_DIR}/dir aubergine              >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tags --explicit ${TEST_DIR}/dir ${TEST_DIR}/dir/file1    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu untag --recursive ${TEST_DIR}/dir aubergine            >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags --explicit ${TEST_DIR}/dir ${TEST_DIR}/dir/file1    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu untagged ${TEST_DIR}/dir | sort                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/dir: aubergine
${TEST_DIR}/dir/file1: aubergine
${TEST_DIR}/dir:
${TEST_DIR}/dir/file1:
${TEST_DIR}/dir
${TEST_DIR}/dir/file1
${TEST_DIR}/dir/file2
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
