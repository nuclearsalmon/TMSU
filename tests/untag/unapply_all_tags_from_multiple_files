#!/usr/bin/env bash

# test

echo 1 >${TEST_DIR}/file1
echo 2 >${TEST_DIR}/file2
tmsu tag --tags="aubergine potato" ${TEST_DIR}/file1 ${TEST_DIR}/file2    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tags --explicit ${TEST_DIR}/file1 ${TEST_DIR}/file2                  >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu untag --all ${TEST_DIR}/file1 ${TEST_DIR}/file2                      >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags --explicit ${TEST_DIR}/file1 ${TEST_DIR}/file2                  >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu untagged ${TEST_DIR}/file1 ${TEST_DIR}/file2                         >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
tmsu: new tag 'potato'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1: aubergine potato
${TEST_DIR}/file2: aubergine potato
${TEST_DIR}/file1:
${TEST_DIR}/file2:
${TEST_DIR}/file1
${TEST_DIR}/file2
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
