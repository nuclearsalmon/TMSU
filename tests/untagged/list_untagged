#!/usr/bin/env bash

# setup

mkdir ${TEST_DIR}/dir
touch ${TEST_DIR}/dir/file1
touch ${TEST_DIR}/dir/file2
touch ${TEST_DIR}/dir/file3
tmsu tag ${TEST_DIR}/dir/file1 aubergine    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# test

tmsu untagged ${TEST_DIR}/dir | sort        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/dir
${TEST_DIR}/dir/file2
${TEST_DIR}/dir/file3
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
