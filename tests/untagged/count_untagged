#!/usr/bin/env bash

# setup

mkdir ${TEST_DIR}/dir
touch ${TEST_DIR}/dir/{file1,file2,file3}
tmsu tag ${TEST_DIR}/dir aubergine          >/dev/null 2>&1
tmsu tag ${TEST_DIR}/dir/file1 aubergine    >/dev/null 2>&1

# test

tmsu untagged --count ${TEST_DIR}/dir       >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
2
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
