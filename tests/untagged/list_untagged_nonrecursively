#!/usr/bin/env bash

# setup

mkdir ${TEST_DIR}/dir
touch ${TEST_DIR}/{file1,file2,file3}
tmsu tag --tags=aubergine ${TEST_DIR}/dir/{file1,file2}    >/dev/null 2>&1

# test

tmsu untagged --directory ${TEST_DIR}/dir                  >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/dir
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
