#!/usr/bin/env bash

# test

tmsu tag --force ${TEST_DIR}/noexist aubergine    >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tags ${TEST_DIR}/noexist                     >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/noexist: aubergine
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
