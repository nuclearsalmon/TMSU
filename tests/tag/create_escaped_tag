#!/usr/bin/env bash

# test

tmsu tag --create one=two        >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tag --create 'two=three'    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
one\=two
two\=three
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
