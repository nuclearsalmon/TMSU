#!/usr/bin/env bash

# setup

mkdir ${TEST_DIR}/dir1
touch ${TEST_DIR}/dir1/file1

# test

tmsu tag ${TEST_DIR}/dir1 aubergine            >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tags --explicit ${TEST_DIR}/dir1          >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags --explicit ${TEST_DIR}/dir1/file1    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/dir1: aubergine
${TEST_DIR}/dir1/file1:
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
