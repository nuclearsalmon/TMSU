#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1

# test

tmsu imply aubergine vegetable                  >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tag ${TEST_DIR}/file1 aubergine vegetable    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags --explicit ${TEST_DIR}/file1            >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags ${TEST_DIR}/file1                       >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
tmsu: new tag 'vegetable'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1: aubergine
${TEST_DIR}/file1: aubergine vegetable
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
