#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1

# test

tmsu tag ${TEST_DIR}/file1 one\\=two     >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tag ${TEST_DIR}/file1 'two\=three'  >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags ${TEST_DIR}/file1              >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'one=two'
tmsu: new tag 'two=three'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1: one\=two two\=three
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
