#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/{file1,file2}

# test

tmsu tag --from=${TEST_DIR}/file1 ${TEST_DIR}/file2    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: ${TEST_DIR}/file1: path is not tagged
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
