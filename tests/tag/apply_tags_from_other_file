#!/usr/bin/env bash

echo 1 >${TEST_DIR}/file1
echo 2 >${TEST_DIR}/file2

# test

tmsu tag ${TEST_DIR}/file1 aubergine potato          >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tag --from=${TEST_DIR}/file1 ${TEST_DIR}/file2    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags ${TEST_DIR}/file1 ${TEST_DIR}/file2          >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
tmsu: new tag 'potato'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1: aubergine potato
${TEST_DIR}/file2: aubergine potato
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
