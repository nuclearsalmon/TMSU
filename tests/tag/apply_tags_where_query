#!/usr/bin/env bash

echo 1 >${TEST_DIR}/file1
echo 2 >${TEST_DIR}/file2
echo 3 >${TEST_DIR}/file3

# test

tmsu tag ${TEST_DIR}/file1 aubergine                          >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu tag ${TEST_DIR}/file2 potato                             >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tag ${TEST_DIR}/file3 shiny-purple-veg                   >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tag --where="aubergine or shiny-purple-veg" eggplant   >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags ${TEST_DIR}/file1 ${TEST_DIR}/file2 ${TEST_DIR}/file3   >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
tmsu: new tag 'aubergine'
tmsu: new tag 'potato'
tmsu: new tag 'shiny-purple-veg'
tmsu: new tag 'eggplant'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1: aubergine eggplant
${TEST_DIR}/file2: potato
${TEST_DIR}/file3: eggplant shiny-purple-veg
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
