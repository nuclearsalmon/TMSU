#!/usr/bin/env bash

if [[ $# -eq 0 ]]; then
    echo "no testcase paths specified" >&2
    exit 1
fi

export TESTS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export PATH="${TMSU_BIN_DIR:-$TESTS_DIR/../bin}:$PATH"

cleanup() {
    if [[ -n ${TEST_DIR:-} ]]; then
        "$TESTS_DIR/teardown" "$TEST_DIR"
        unset TEST_DIR
    fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

for testcase in "$@"; do
    if ! . "$TESTS_DIR/setup"; then
        echo "$testcase [SETUP FAIL]" >&2
        exit 1
    fi

    "$testcase"
    RC=$?
    echo -n "$testcase "
    if [[ $RC -eq 0 ]]; then
        echo "[PASS]"
        cleanup
    else
        echo "[FAIL]"
        exit 1
    fi
done
