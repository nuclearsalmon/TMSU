#!/usr/bin/env bash

# setup

tmsu tag --create aubergine eggplant    >/dev/null 2>&1

# test

tmsu delete aubergine eggplant          >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

tmsu files aubergine                    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files eggplant                     >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: no such tag 'aubergine'
tmsu: no such tag 'eggplant'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
