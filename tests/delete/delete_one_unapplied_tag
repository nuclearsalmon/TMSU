#!/usr/bin/env bash

# setup

tmsu tag --create aubergine    >/dev/null 2>&1

# test

tmsu delete aubergine          >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

tmsu files aubergine           >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
tmsu: no such tag 'aubergine'
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
