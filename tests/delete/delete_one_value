#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file1
tmsu tag ${TEST_DIR}/file1 year=2015    >/dev/null 2>&1

# test

tmsu delete --value 2015              >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

tmsu values                           >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
