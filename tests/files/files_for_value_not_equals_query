#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/{file1,file2,file3,file4}
tmsu tag --tags="month=June" ${TEST_DIR}/file1               >/dev/null 2>&1
tmsu tag --tags="month=July" ${TEST_DIR}/file2               >/dev/null 2>&1
tmsu tag --tags="blah" ${TEST_DIR}/file3                     >/dev/null 2>&1
tmsu tag --tags="month=June month=July" ${TEST_DIR}/file4    >/dev/null 2>&1

# test

tmsu files "month != June"                                 >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file2
${TEST_DIR}/file3
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
