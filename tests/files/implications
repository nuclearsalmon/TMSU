${TEST_DIR}/file4
${TEST_DIR}/file1
${TEST_DIR}/file3
${TEST_DIR}/file4
${TEST_DIR}/file1
${TEST_DIR}/file3
${TEST_DIR}/file4
---
${TEST_DIR}/file1
${TEST_DIR}/file2
${TEST_DIR}/file4
${TEST_DIR}/file1
${TEST_DIR}/file2
${TEST_DIR}/file4
