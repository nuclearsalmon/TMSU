#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/file{1..4}

tmsu imply a b                          >/dev/null 2>&1
tmsu imply b c                          >/dev/null 2>&1
tmsu imply j=1 k                        >/dev/null 2>&1
tmsu imply k l                          >/dev/null 2>&1
tmsu imply x y=2                        >/dev/null 2>&1
tmsu imply y z                          >/dev/null 2>&1

tmsu tag ${TEST_DIR}/file1 a              >/dev/null 2>&1
tmsu tag ${TEST_DIR}/file2 j=1            >/dev/null 2>&1
tmsu tag ${TEST_DIR}/file3 x              >/dev/null 2>&1
tmsu tag ${TEST_DIR}/file4 j=2            >/dev/null 2>&1

# test

tmsu files a                            >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu files b                            >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files c                            >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files a b c                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
echo ---                                >>${TEST_DIR}/stdout

tmsu files j=1                          >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files k                            >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files l                            >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files j=1 k l                      >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
echo ---                                >>${TEST_DIR}/stdout

tmsu files x                            >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files y=2                          >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files z                            >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files x y=2 z                      >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
echo ---                                >>${TEST_DIR}/stdout

tmsu files j=2                          >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
echo ---                                >>${TEST_DIR}/stdout

tmsu files not a                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files not b                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files not c                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
echo ---                                >>${TEST_DIR}/stdout

tmsu files not j                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files not j=1                      >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files not k                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files not l                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
echo ---                                >>${TEST_DIR}/stdout

tmsu files not x                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files not y                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files not y=2                      >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu files not z                        >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
echo ---                                >>${TEST_DIR}/stdout

tmsu tags ${TEST_DIR}/file1               >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags --explicit ${TEST_DIR}/file1    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags ${TEST_DIR}/file2               >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags --explicit ${TEST_DIR}/file2    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags ${TEST_DIR}/file3               >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags --explicit ${TEST_DIR}/file3    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags ${TEST_DIR}/file4               >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr
tmsu tags --explicit ${TEST_DIR}/file4    >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1
${TEST_DIR}/file1
${TEST_DIR}/file1
${TEST_DIR}/file1
---
${TEST_DIR}/file2
${TEST_DIR}/file2
${TEST_DIR}/file2
${TEST_DIR}/file2
---
${TEST_DIR}/file3
${TEST_DIR}/file3
${TEST_DIR}/file3
${TEST_DIR}/file3
---
${TEST_DIR}/file4
---
${TEST_DIR}/file2
${TEST_DIR}/file3
${TEST_DIR}/file4
