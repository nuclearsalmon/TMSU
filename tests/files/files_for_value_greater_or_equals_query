#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/{file1,file2}
tmsu tag --tags="year=2015" ${TEST_DIR}/file1    >/dev/null 2>&1
tmsu tag --tags="year=2016" ${TEST_DIR}/file2    >/dev/null 2>&1

# test

tmsu files "year >= 2015"                      >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file1
${TEST_DIR}/file2
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
