#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/{file1,file2}
mkdir ${TEST_DIR}/dir1
tmsu tag --tags="aubergine" ${TEST_DIR}/{file1,dir1}    >/dev/null 2>&1

# test

tmsu files --directory aubergine                      >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/dir1
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
