#!/usr/bin/env bash

# setup

touch ${TEST_DIR}/{file1,file2}
tmsu tag --tags="aubergine" ${TEST_DIR}/file1 ${TEST_DIR}/file2   >/dev/null 2>&1
tmsu tag --tags="potato" ${TEST_DIR}/file2                      >/dev/null 2>&1

# test

tmsu files aubergine and potato                               >|${TEST_DIR}/stdout 2>|${TEST_DIR}/stderr
tmsu files aubergine and not potato                           >>${TEST_DIR}/stdout 2>>${TEST_DIR}/stderr

# verify

diff ${TEST_DIR}/stderr - <<EOF
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi

diff ${TEST_DIR}/stdout - <<EOF
${TEST_DIR}/file2
${TEST_DIR}/file1
EOF
if [[ $? -ne 0 ]]; then
    exit 1
fi
